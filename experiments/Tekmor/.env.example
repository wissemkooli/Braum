# Copy to .env and fill in. Never commit .env — it is gitignored.
# Placeholder values only in this file.

# Agent backend: "mock" for deterministic offline runs, "hf" for local Hugging Face
# Transformers (keeps activation hooks available), "vllm" for an OpenAI-compatible server.
TEKMOR_MODEL_BACKEND=mock

# Reference agent model (see docs/technical-doc.md).
TEKMOR_MODEL_NAME=Qwen/Qwen3-8B

# Base URL when TEKMOR_MODEL_BACKEND=vllm.
TEKMOR_VLLM_BASE_URL=http://localhost:8000/v1

# Hugging Face cache directory and token (token only needed for gated models).
HF_HOME=
HUGGING_FACE_HUB_TOKEN=

# Where the append-only JSONL event log is written.
TEKMOR_LOG_DIR=./runs

# Default seed for reproducible runs.
TEKMOR_SEED=0
